<!doctype html>
<html lang="{{ 'nb' if L.home == 'Hjemme' else 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ nl.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#ECEAE3;">
{# Hidden inbox preview line #}
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ nl.preview_text }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ECEAE3;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#FFFFFF;font-family:Arial,Helvetica,sans-serif;color:#111111;">

{% if preview %}
<tr><td style="background:#FFF4C2;border:3px dashed #111111;padding:20px 24px;">
{% include "_approve_box.html.j2" %}
</td></tr>
{% endif %}

{# Top strip #}
<tr><td style="background:#111111;padding:10px 24px;font-size:11px;letter-spacing:2px;font-weight:bold;color:#FFD320;">
  {{ club.club_name | upper }} · {{ club.newsletter.name | upper }} · {{ L.issue | upper }} #{{ issue_no }} · {{ today.day }} {{ L.months[today.month - 1] }} {{ today.year }}
</td></tr>

{# Masthead #}
<tr><td style="background:#FFD320;padding:22px 24px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td width="84" valign="middle"><img src="{{ site_url }}/img/logo.png" width="72" alt="IK Start" style="display:block;border:0;"></td>
    <td valign="middle" style="font-family:Impact,'Arial Black',Arial,sans-serif;font-size:40px;line-height:1;letter-spacing:1px;color:#111111;">{{ club.newsletter.name | upper }}</td>
  </tr></table>
</td></tr>

{# Hero #}
<tr><td style="background:#111111;padding:0;">
  <img src="{{ site_url }}/img/hero.jpg" width="600" alt="" style="display:block;width:100%;height:auto;border:0;">
</td></tr>
<tr><td style="background:#111111;padding:22px 24px 26px;">
  <p style="margin:0;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:34px;line-height:1.05;color:#FFD320;">{{ nl.headline | upper }}</p>
  <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:#FFFFFF;">{{ nl.intro }}</p>
</td></tr>

{# Results #}
{% if results %}
<tr><td style="padding:28px 24px 4px;">
  <p style="margin:0;font-size:11px;font-weight:bold;letter-spacing:2px;color:#3550A8;">{{ L.results | upper }}</p>
</td></tr>
{% for r in results %}
<tr><td style="padding:10px 24px 6px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#111111;border-radius:12px;">
    <tr><td colspan="3" style="padding:12px 16px 0;font-size:11px;letter-spacing:1.5px;color:#BDBDBD;">{{ r.m.team_label | upper }} · {{ r.m.competition | upper }} · {{ r.m.day }} {{ r.m.month }}</td></tr>
    <tr>
      <td width="40%" align="center" style="padding:14px 8px;font-size:14px;font-weight:bold;color:#FFFFFF;">{{ r.m.home_team }}</td>
      <td width="20%" align="center" style="padding:14px 4px;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:40px;color:#FFD320;">{{ r.m.home_goals }}&ndash;{{ r.m.away_goals }}</td>
      <td width="40%" align="center" style="padding:14px 8px;font-size:14px;font-weight:bold;color:#FFFFFF;">{{ r.m.away_team }}</td>
    </tr>
    {% if r.m.scorers or r.m.attendance %}
    <tr><td colspan="3" align="center" style="padding:0 16px 14px;font-size:12px;color:#CFCFCF;">
      {% if r.m.scorers %}{{ L.goals }}: {{ r.m.scorers | join(', ') }}{% endif %}{% if r.m.scorers and r.m.attendance %} · {% endif %}{% if r.m.attendance %}{{ r.m.attendance }} {{ L.fans }}{% endif %}
    </td></tr>
    {% endif %}
  </table>
  <p style="margin:14px 0 4px;font-size:18px;font-weight:bold;line-height:1.3;">{{ r.headline }}</p>
  <p style="margin:0;font-size:15px;line-height:1.6;color:#333333;">{{ r.recap }}</p>
</td></tr>
{% endfor %}
{% endif %}

{# Tables #}
{% for t in tables %}
<tr><td style="padding:24px 24px 4px;">
  <p style="margin:0 0 8px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#3550A8;">{{ L.table | upper }} · {{ t.label | upper }}</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:13px;border:1px solid #E4E1D8;">
    <tr style="background:#F4F2EC;">
      <td style="padding:7px 10px;font-weight:bold;">{{ L.pos }}</td><td style="padding:7px 10px;font-weight:bold;">{{ L.club }}</td>
      <td align="center" style="padding:7px 6px;font-weight:bold;">{{ L.p }}</td><td align="center" style="padding:7px 6px;font-weight:bold;">{{ L.gd }}</td>
      <td align="center" style="padding:7px 10px;font-weight:bold;">{{ L.pts }}</td>
    </tr>
    {% for row in t.rows %}
    {% set us = 'Start' in row.club %}
    <tr style="{{ 'background:#FFF4C2;font-weight:bold;' if us else '' }}">
      <td style="padding:7px 10px;border-top:1px solid #E4E1D8;">{{ row.pos }}</td>
      <td style="padding:7px 10px;border-top:1px solid #E4E1D8;">{{ row.club }}</td>
      <td align="center" style="padding:7px 6px;border-top:1px solid #E4E1D8;">{{ row.played }}</td>
      <td align="center" style="padding:7px 6px;border-top:1px solid #E4E1D8;">{{ row.gd }}</td>
      <td align="center" style="padding:7px 10px;border-top:1px solid #E4E1D8;font-weight:bold;">{{ row.pts }}</td>
    </tr>
    {% endfor %}
  </table>
  {% if t.note %}<p style="margin:8px 0 0;font-size:13px;line-height:1.5;color:#555555;">{{ t.note }}</p>{% endif %}
</td></tr>
{% endfor %}

{# Player spotlight #}
{% if spotlight %}
<tr><td style="padding:28px 24px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F4F2EC;border-radius:12px;">
    <tr><td style="padding:20px;">
      <p style="margin:0 0 6px;font-size:11px;font-weight:bold;letter-spacing:2px;color:#3550A8;">{{ L.spotlight | upper }}</p>
      {% if spotlight.image_url %}<img src="{{ spotlight.image_url }}" width="520" alt="{{ spotlight.title }}" style="display:block;width:100%;height:auto;border-radius:8px;margin:0 0 12px;">{% endif %}
      <p style="margin:0 0 8px;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:26px;line-height:1.1;">{{ spotlight.title | upper }}</p>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#333333;">{{ spotlight.text }}</p>
    </td></tr>
  </table>
</td></tr>
{% endif %}

{# Coach quote #}
{% if coach and coach.quote %}
<tr><td style="padding:20px 24px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFD320;border-radius:12px;">
    <tr><td style="padding:20px 22px;">
      <p style="margin:0 0 6px;font-size:11px;font-weight:bold;letter-spacing:2px;">{{ L.coach | upper }}</p>
      <p style="margin:0;font-size:19px;font-weight:bold;line-height:1.4;">&ldquo;{{ coach.quote }}&rdquo;</p>
      <p style="margin:10px 0 0;font-size:13px;">{{ coach.quote_by }}</p>
    </td></tr>
  </table>
</td></tr>
{% endif %}

{# Next games #}
{% if next_games %}
<tr><td style="padding:28px 24px 4px;">
  <p style="margin:0;font-size:11px;font-weight:bold;letter-spacing:2px;color:#3550A8;">{{ L.next | upper }}</p>
</td></tr>
{% for g in next_games %}
<tr><td style="padding:10px 24px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:2px solid #111111;border-radius:12px;">
    <tr>
      <td width="76" align="center" valign="middle" style="background:{{ '#FFD320' if g.m.is_home else '#F4F2EC' }};border-radius:10px 0 0 10px;padding:12px 6px;">
        <p style="margin:0;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:30px;line-height:1;">{{ g.m.day }}</p>
        <p style="margin:2px 0 0;font-size:11px;font-weight:bold;letter-spacing:1px;">{{ g.m.month }}</p>
      </td>
      <td valign="middle" style="padding:12px 14px;">
        <p style="margin:0;font-size:11px;letter-spacing:1.5px;color:#3550A8;font-weight:bold;">{{ g.m.team_label | upper }} · {{ (L.home if g.m.is_home else L.away) | upper }}</p>
        <p style="margin:3px 0 2px;font-size:16px;font-weight:bold;">{{ g.m.home_team }} &ndash; {{ g.m.away_team }}</p>
        <p style="margin:0;font-size:13px;color:#555555;">{{ g.m.weekday }} {{ g.m.kickoff }} · {{ g.m.venue }}</p>
        <p style="margin:6px 0 0;font-size:14px;line-height:1.5;">{{ g.hook }}</p>
        {% if g.m.ticket_url %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:10px;"><tr>
          <td style="background:#111111;border-radius:20px;"><a href="{{ g.m.ticket_url }}" style="display:inline-block;padding:9px 18px;font-size:13px;font-weight:bold;color:#FFD320;text-decoration:none;">{{ L.tickets }} &rarr;</a></td>
        </tr></table>
        {% endif %}
      </td>
    </tr>
  </table>
</td></tr>
{% endfor %}
{% endif %}

{# Event / giveaway / partner / volunteer cards #}
{% for key, block, bg in [('event', event, '#111111'), ('giveaway', giveaway, '#FFF4C2'), ('partner', partner, '#F4F2EC'), ('volunteer', volunteer, '#F4F2EC')] %}
{% if block %}
<tr><td style="padding:20px 24px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ bg }};border-radius:12px;{{ 'border:2px dashed #E3B800;' if key == 'giveaway' else '' }}">
    <tr><td style="padding:20px 22px;color:{{ '#FFFFFF' if bg == '#111111' else '#111111' }};">
      <p style="margin:0 0 6px;font-size:11px;font-weight:bold;letter-spacing:2px;color:{{ '#FFD320' if bg == '#111111' else '#3550A8' }};">{{ L[key] | upper }}</p>
      <p style="margin:0 0 6px;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:22px;line-height:1.15;">{{ block.title | upper }}</p>
      <p style="margin:0;font-size:15px;line-height:1.6;">{{ block.text }}</p>
      {% if block.link %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;"><tr>
        <td style="background:{{ '#FFD320' if bg == '#111111' else '#111111' }};border-radius:20px;"><a href="{{ block.link }}" style="display:inline-block;padding:9px 18px;font-size:13px;font-weight:bold;color:{{ '#111111' if bg == '#111111' else '#FFD320' }};text-decoration:none;">{{ L.read_more }} &rarr;</a></td>
      </tr></table>
      {% endif %}
    </td></tr>
  </table>
</td></tr>
{% endif %}
{% endfor %}

{# Footer #}
<tr><td style="padding:28px 0 0;"></td></tr>
<tr><td style="background:#111111;padding:24px;">
  <p style="margin:0 0 10px;font-family:Impact,'Arial Black',Arial,sans-serif;font-size:20px;color:#FFD320;">{{ club.club_name | upper }}</p>
  <p style="margin:0 0 14px;font-size:13px;line-height:1.8;">
    <a href="{{ club.links.website }}" style="color:#FFFFFF;text-decoration:underline;">{{ L.website }}</a> &nbsp;·&nbsp;
    <a href="{{ club.links.tickets }}" style="color:#FFFFFF;text-decoration:underline;">{{ L.tickets }}</a> &nbsp;·&nbsp;
    <a href="{{ club.links.instagram }}" style="color:#FFFFFF;text-decoration:underline;">Instagram</a> &nbsp;·&nbsp;
    <a href="{{ club.links.facebook }}" style="color:#FFFFFF;text-decoration:underline;">Facebook</a>
  </p>
  <p style="margin:0;font-size:11px;line-height:1.5;color:#9A9A9A;">{{ L.footer }}</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
